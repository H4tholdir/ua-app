+// ═══ costruisciCardAvviso — la card ⟺ lavoro risolto; il chip ⟺ DdC viva E lavoro consegnato ═══
+describe('costruisciCardAvviso', () => {
+  const GRUPPO_A: CardAvviso = {
+    lavoroId: LAVORO_A,
