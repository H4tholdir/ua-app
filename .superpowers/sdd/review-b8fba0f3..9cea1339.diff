+      riga({ id: 'a2', lavoro_id: LAVORO_A, created_at: '2026-08-09T08:00:00.000Z' }),
+      riga({ id: 'a3', lavoro_id: LAVORO_A, created_at: '2026-08-05T10:00:00.000Z' }),
