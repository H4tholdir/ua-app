+  it('nessuna divergenza mai registrata (default DB \'[]\') → array vuoto, non undefined', () => {
+    const senza = { ...RIGA_BASE, divergenze: [] }
+    const risultato = normalizzaPrescrizione(senza)
+    expect(risultato?.divergenze).toEqual([])
