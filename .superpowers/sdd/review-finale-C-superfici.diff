+function StrisciaAttesa(props: { restanoSec: number; soloVia: boolean; onAnnulla: () => void }) {
+  const { restanoSec, soloVia, onAnnulla } = props
+  return (
+    <div
+      role={soloVia ? 'status' : undefined}
