+            : { lavoro: { updated_at: '2026-08-04T12:00:00.999999+00:00' } },
+    }))
+    vi.stubGlobal('fetch', fetchMock)
+    return fetchMock
+  }
+
+  /** Un lavoro nello stato (a): trascritto A3, vivo A3, pastiglia verde. */
+  function lavoroTrascritto() {
+    return makeLavoro({
