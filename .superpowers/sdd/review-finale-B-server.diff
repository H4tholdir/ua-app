+  const validi: number[] = []
+  for (const offset of candidati) {
+    const istante = comeSeFosseUTC - offset
+    // Si tiene solo l'offset che si RICONFERMA sull'istante che produce.
+    if (offsetRomaMs(istante) === offset) validi.push(istante)
+  }
