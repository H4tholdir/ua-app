+ * all'incontrario sbaglia **tutte e cinque** le righe insieme.
+ */
+const ATTESO_CHIUSURA: Record<(typeof CINQUE_RUOLI)[number], boolean> = {
+  titolare: true,
+  tecnico: true,
+  front_desk: true,
+  admin_rete: false,
