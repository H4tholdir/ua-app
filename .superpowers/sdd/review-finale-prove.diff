+      await inserisci('prima viva')
+      const errore = await attesoRifiuto(client, 'seconda valutazione viva sullo stesso evento', () =>
+        inserisci('seconda viva')
+      )
+      expect(errore).toMatch(/valutazione_viva_unique/)
+    })
+  })
+
