+    const sql = istruzioni()
+    expect(
+      sql,
+      PERCHE_CONDIVISA
+    ).not.toMatch(
+      /\b(?:CREATE|DROP|ALTER)\s+(?:OR REPLACE\s+)?FUNCTION\s+(?:IF EXISTS\s+)?(?:public\.)?trigger_set_updated_at\b/
+    )
