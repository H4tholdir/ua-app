+        //    che la query chieda l'embed della prescrizione.
+        select: (arg: string) => {
+          selectArgs.push(arg)
+          return { eq: () => ({ eq: () => ({ is: () => ({ single: async () => ({ data: rigaLavoro(prescrizioneRaw), error: null }) }) }) }) }
+        },
+        update: () => ({ eq: () => ({ eq: () => Promise.resolve({ error: null, count: 1 }) }) }),
+      }
+    }
