+/** Inserisce un avviso, lasciando scegliere al chiamante i campi di stato. */
+function inserisci(
+  client: Client,
+  rif: { lavoro_id: string; cliente_id: string; dichiarazione_id: string },
+  campi: Record<string, unknown>
