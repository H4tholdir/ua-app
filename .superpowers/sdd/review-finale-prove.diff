+      // §8.2 — il MOTIVO dell'annullamento, collegato e non duplicato.
+      expect(vecchiaRiga.annullata_da_evento_id).toBe(evento)
+
+      const nuovaRiga = rows.find((x) => x.id === r.nuova_id)!
