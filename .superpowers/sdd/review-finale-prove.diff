+
+  it('è un allarme, non un racconto: precede i racconti quieti della catena di ripiego', () => {
+    const s = scegliSegnale('titolare', { ...VUOTO,
+      avvisoDaComunicare: AVVISO, parete: { n: 12, introVista: false }, ddcOggi: 4 })
