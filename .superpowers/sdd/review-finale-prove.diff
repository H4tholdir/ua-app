+      then(risolvi: (v: unknown) => unknown, rifiuta?: (e: unknown) => unknown) {
+        const esito = guasto ? { data: null, error: { message: 'connessione caduta' } } : { data: righe, error: null }
+        return Promise.resolve(esito).then(risolvi, rifiuta)
