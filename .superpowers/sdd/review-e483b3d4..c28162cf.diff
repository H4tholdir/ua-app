+            riferimento: typeof f.fonte_riferimento === 'string' ? f.fonte_riferimento : null,
+          }
+        }
+      } catch {
+        /* si tiene `atteso` — v. sopra */
+      }
+      onFonte(scritta)
+      return true
+    } catch {
+      errore(fraseGenerica)
+      return false
+    }
+  }
+
+  /** ① e ② finiscono qui: stesso viaggio, tipo diverso dedotto dal file. */
