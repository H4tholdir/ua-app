+        const dati = (await res.json()) as {
+          fonte?: { fonte_tipo?: unknown; fonte_immagine_id?: unknown; fonte_riferimento?: unknown }
+        } | null
+        const f = dati?.fonte
+        if (f && isFonteTipo(f.fonte_tipo)) {
