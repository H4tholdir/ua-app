+/* ── Mobilio del file: etichette per chi legge il mockup a occhio.
+      NON fanno parte del disegno approvato e NON entrano negli scatti
+      (gli scatti clippano l'elemento .scena, non la pagina intera). ── */
+.nota-scena{
+  max-width:900px;margin:0 auto;padding:28px 24px 10px;
+  font-size:13px;font-weight:800;text-transform:uppercase;letter-spacing:.12em;
+  color:#7a7266;
+}
+.nota-scena b{color:#3a352c}
+
+/* ── .scena: il riquadro che UN singolo scatto cattura. Larghezza 100%,
+      altezza 100vh — a ogni resize del viewport (390/768/1280) diventa
+      esattamente il rettangolo di un vero schermo, overflow:hidden come
+      farebbe un device reale. position:relative così scrim/foglio (sotto)
+      possono restare `absolute` invece di `fixed`: `fixed` prenderebbe come
+      riferimento l'INTERA pagina (con le etichette sopra), non il riquadro
+      — qui la scena è pensata per essere l'intero schermo, quindi l'ancora
+      giusta è lei stessa. ── */
+.scena{
+  position:relative;width:100%;height:100vh;max-height:960px;overflow:hidden;
+  background:var(--bg);
+  margin:0 auto 40px;max-width:1280px;
+}
+
+/* ══════════════ SFONDO A — wizard «Nuovo lavoro», Passo 1 ══════════════ */
+.sf-testata{display:flex;align-items:center;gap:14px;padding:20px 24px 4px}
+.sf-tondo{
+  width:46px;height:46px;flex:none;border-radius:999px;border:none;
+  background:var(--card);box-shadow:var(--sh-card);
+  font-size:19px;font-weight:800;color:var(--ink);
+}
+[data-tema="dark"] .sf-tondo{border:1px solid var(--line)}
+.sf-passo{font-size:12.5px;font-weight:800;text-transform:uppercase;letter-spacing:.14em;color:var(--faint)}
+.sf-corpo{max-width:480px;margin:0 auto;padding:18px 24px 0}
+.sf-domanda{font-size:31px;font-weight:800;letter-spacing:-0.02em;line-height:1.1;color:var(--ink)}
+.sf-hint{font-size:15.5px;font-weight:600;color:var(--muted);margin-top:8px}
+.sf-griglia{display:grid;grid-template-columns:1fr 1fr;gap:15px;margin-top:22px}
+.sf-tile{
+  background:var(--card);border-radius:22px;padding:16px;box-shadow:var(--sh-card);
+  display:flex;flex-direction:column;gap:8px;
+}
+[data-tema="dark"] .sf-tile{border:1px solid var(--line)}
+.sf-avatar{width:34px;height:34px;border-radius:999px;background:var(--blue);color:#fff;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:800}
+.sf-tile-nome{font-size:15.5px;font-weight:800;color:var(--ink)}
+.sf-tile-sotto{font-size:12.5px;font-weight:600;color:var(--muted)}
+.sf-tile-nuovo{
+  grid-column:1 / -1;background:var(--card);border-radius:22px;padding:18px;
+  box-shadow:var(--sh-card);text-align:center;font-size:17px;font-weight:800;color:var(--red);
+  border:1.5px dashed var(--line);
+}
+
+/* ══════════════ SFONDO B — «Consegnato!», prima di WhatsApp ══════════════ */
+.sg-corpo{max-width:480px;margin:0 auto;padding:20px 24px 0;text-align:center}
+.sg-check{width:78px;height:78px;border-radius:999px;background:var(--green-tint);color:var(--green);display:flex;align-items:center;justify-content:center;margin:0 auto 14px}
+.sg-titolo{font-size:31px;font-weight:800;letter-spacing:-0.02em;color:var(--ink)}
+.sg-sotto{font-size:15.5px;font-weight:600;color:var(--muted);margin-top:8px;max-width:300px;margin-inline:auto}
+.sg-lista{background:var(--card);border-radius:24px;padding:6px 18px;margin-top:20px;box-shadow:var(--sh-card);text-align:left}
+[data-tema="dark"] .sg-lista{border:1px solid var(--line)}
+.sg-riga{display:flex;align-items:center;gap:12px;padding:13px 0;border-bottom:1px solid var(--line)}
+.sg-riga:last-child{border-bottom:none}
+.sg-spunta{flex:none;width:26px;height:26px;border-radius:999px;background:var(--green-tint);color:var(--green);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:900}
+.sg-riga-nome{font-size:15.5px;font-weight:700;color:var(--ink)}
+.sg-riga-sub{font-size:13px;font-weight:600;color:var(--muted)}
+.sg-nota{font-size:14.5px;font-weight:600;color:var(--muted);margin-top:16px}
+
+/* ══════════════ Overlay: scrim + Sheet — copiato da Sheet.tsx §5.16 ══════════════
+   `position:absolute` (non `fixed`, v. commento su .scena sopra) — inset:0
+   rispetto al riquadro .scena, che qui FA le veci dell'intero viewport. */
+.scrim{position:absolute;inset:0;background:var(--scrim)}
+.sheet-wrap{position:absolute;inset:0;display:flex;align-items:flex-end;justify-content:center}
+.foglio{
+  position:relative;width:100%;max-width:480px;max-height:92%;overflow-y:auto;
+  background:var(--card);
+  /* 🛑 --card, non --elv. Verificato in src/components/ds/Sheet.tsx:508: il pannello
+     dipinge var(--card), NON var(--elv) — nonostante la spec §3.2 assegni --elv ai
+     fogli. Questa divergenza fra spec e codice è GIÀ tracciata come bug P34 in
+     ROADMAP-UFFICIALE.md (trovato dall'esecutore del compito 5 di questo stesso
+     piano) — riferita là, non "corretta" qui. Questo disegno copia il codice VERO
+     oggi, non la spec: usare --elv qui avrebbe ripetuto lo stesso scarto che ha
+     generato quel bug, invece di limitarsi a fotografarlo. */
+  border-top-left-radius:28px;border-top-right-radius:28px;
+  padding:32px 24px 24px;
+  box-shadow:var(--sh-card);
+}
+.maniglia{position:absolute;top:8px;left:50%;transform:translateX(-50%);width:36px;height:4px;border-radius:999px;background:var(--line)}
+.foglio-titolo{font-size:21px;font-weight:800;color:var(--ink);margin:0 0 16px}
+.foglio-campi{display:flex;flex-direction:column;gap:16px}
+.foglio-chiudi-wrap{margin-top:24px;display:flex;justify-content:center}
+
+/* ══════════════ Campo — copiato VERBATIM da src/components/ds/Campo.tsx ══════════════ */
+.label{
+  display:block;font-size:13px;font-weight:800;text-transform:uppercase;
+  letter-spacing:.16em;color:var(--faint);margin-bottom:4px;
+}
+.campo{
+  display:block;box-sizing:border-box;width:100%;height:64px;border-radius:18px;
+  border:1px solid var(--line);background:var(--card);color:var(--ink);
+  font-family:inherit;font-size:19px;font-weight:700;padding:0 20px;
+}
+.campo::placeholder{color:var(--faint);font-weight:700;opacity:1}
+.campo:focus{outline:2px solid var(--blue);outline-offset:2px}
+/* Riga sotto il campo (P31, D184) — --muted, MAI --faint (v. Campo.tsx:32-35,
+   difetto già aperto P30-bis: --faint su un foglio scende sotto soglia). */
+.aiuto{margin:6px 0 0;font-size:13px;line-height:1.35;color:var(--muted)}
+
+/* Contesto informativo sopra il campo (non è un componente v3 a sé — solo
+   testo, stesso ruolo di .foglio-domanda nei mockup P30 dello stesso giorno). */
+.contesto{font-size:15.5px;font-weight:600;color:var(--muted);line-height:1.4}
+.contesto b{color:var(--ink);font-weight:800}
+
+/* ══════════════ TastoPrimario — copiato VERBATIM da TastoPrimario.tsx §5.1 ══════════════ */
+.tp-wrap{width:100%;max-width:480px;border-radius:20px;box-shadow:var(--sh-card)}
+.tp-btn{
+  width:100%;height:70px;border-radius:20px;border:none;
+  background:linear-gradient(180deg,#F2263A,var(--red) 55%,#B00010);
+  color:#FFFFFF;font-family:inherit;font-size:21px;font-weight:800;
+  letter-spacing:.04em;text-transform:uppercase;
+  box-shadow:0 6px 0 var(--red-dark);cursor:pointer;
+}
+@media(min-width:1024px){ .tp-btn{height:60px} }
+.tp-btn:focus-visible{outline:2px solid var(--blue);outline-offset:2px}
+
+/* ══════════════ LinkQuieto «Chiudi» — copiato VERBATIM da LinkQuieto.tsx §5.5 ══════════════
+   Testo visivo 14.5px sottolineato, ma l'area tappabile è 44px: padding 13px
+   sopra e sotto + margin -13px uguale e contrario, così l'aspetto non cambia
+   di un pixel e cambia solo quanto è facile centrarla col dito (lezione della
+   notte 2-3 agosto: un mockup che NON lo copia inventa una via di fuga
+   342×18 che il componente vero non ha). */
+.chiudi{
+  display:inline-flex;align-items:center;min-height:44px;padding:13px 0;margin:-13px 0;
+  background:none;border:none;cursor:pointer;font-family:inherit;
+  font-size:14.5px;font-weight:600;color:var(--muted);
+  text-decoration:underline;text-underline-offset:3px;
+}
+.chiudi:focus-visible{outline:2px solid var(--blue);outline-offset:2px}
+</style>
+</head>
+<body>
+
+<div class="nota-scena">Foglio 1 di 2 — <b>il wizard «nuovo dentista»</b>, cinque campi (D184)</div>
+<div class="scena" id="scena-a">
+  <!-- Sfondo: Passo 1 del wizard «Nuovo lavoro» (contesto — non è l'oggetto
+       dell'approvazione, per questo resta semplificato rispetto a
+       PassoDentista.tsx reale). Due dentisti già in rubrica + il tasto
+       "+ Nuovo dentista" che ha aperto il foglio. -->
+  <div class="sf-testata">
