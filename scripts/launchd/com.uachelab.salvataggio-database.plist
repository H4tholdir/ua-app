<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.uachelab.salvataggio-database</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/hatholdir/Library/Application Support/UA-salvataggio/scripts/salvataggio-programmato.sh</string>
  </array>

  <!-- ⏰ OGNI GIORNO ALLE 11:00, e l'ora è stata SPOSTATA il 08/08/2026 su un
       fatto misurato, non su una preferenza.
       Fino a quel giorno era le 3:00, e il registro dice com'è andata:
       `~/Backup-UA-database/launchd.log` porta un giro riuscito ogni notte fino
       al 2026-08-05 03:00, e poi PIÙ NIENTE — nessuna riga il 6, il 7, l'8.
       Non un errore: il lavoro non è proprio partito, perché il Mac era spento,
       e launchd NON ha recuperato al risveglio.
       🛑 Il commento che stava qui diceva «che cosa faccia macOS se il Mac è
       spento: NON VERIFICATO». Adesso è verificato, e la risposta è: non fa
       niente. Tre giorni senza copia di sicurezza.
       🔑 Le 11:00 le ha indicate Francesco: «di solito il pc lavora sempre
       intorno alle 11.00».
       ⚠️ RESTA VERO che se il Mac è spento anche alle 11:00 quel giorno si
       salta: launchd non recupera. Un secondo orario è possibile, ma lo script
       NON salta quando una copia di oggi esiste già (`launchd.log`: «ultima
       copia: … 0 giorni fa» e poi ne fa un'altra), quindi due orari = due copie
       al giorno. Scelta rimandata, non dimenticata. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>11</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <!-- 🛑 false: non deve ripartire a ogni accesso, solo all'ora stabilita -->
  <key>RunAtLoad</key>
  <false/>

  <key>WorkingDirectory</key>
  <string>/Users/hatholdir/Library/Application Support/UA-salvataggio</string>

  <!-- launchd non dà il PATH del terminale: node e npx vanno nominati -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/hatholdir/Backup-UA-database/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/hatholdir/Backup-UA-database/launchd.log</string>

  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
